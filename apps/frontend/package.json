    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.1.0",
    "typescript": "latest",
    "vitest": "^5.0.1"
  }

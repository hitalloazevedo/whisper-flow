DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whisper_flow

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=whisper-flow-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Fallback poll interval: the worker LISTENs for a Postgres NOTIFY on new
# jobs and reacts immediately, but re-checks the table on this cadence
# regardless, in case a notification is ever missed.
POLL_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

# Serves GET /health only (200 once startup finished, 503 before, 404 on any
# other path) — used for container/orchestrator health checks.
HEALTH_PORT=8000

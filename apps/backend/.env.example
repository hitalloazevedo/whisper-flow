PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whisper_flow
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
SESSION_SECRET=replace-with-a-long-random-secret

S3_ENDPOINT=http://localhost:9000
# Optional: only needed when S3_ENDPOINT isn't reachable from the browser (e.g. a
# Docker service name like http://minio:9000). Presigned upload/download URLs are
# signed against this host instead. Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=whisper-flow-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

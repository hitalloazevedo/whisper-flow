# Production environment for docker-compose.prod.yml, deployed to the VPS.
# Copy to `.env` next to docker-compose.prod.yml on the VPS — never commit
# the real file. GHCR_NAMESPACE and IMAGE_TAG are set by the deploy
# workflow at deploy time, not read from this file.
#
# Two more values are baked into the frontend image at build time, so they
# live as GitHub Actions repo variables (Settings > Secrets and variables >
# Actions > Variables), not here:
#   VITE_API_URL=https://lab.hitalloazevedo.com/whisper-flow-api
#   VITE_BASE_PATH=/whisper-flow/

# Points at the VPS's shared Postgres instance (its own compose stack, on
# the external `shared-db` Docker network — see docs/ADR/010). Create the
# whisper_flow database/user there first:
#   CREATE USER whisper_flow_user WITH PASSWORD '...';
#   CREATE DATABASE whisper_flow OWNER whisper_flow_user;
DATABASE_URL=postgresql://whisper_flow_user:replace-with-a-long-random-secret@postgres:5432/whisper_flow

S3_BUCKET=whisper-flow-audio
S3_ACCESS_KEY_ID=replace-with-a-long-random-secret
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret

# Host-side ports; kept off 80/443 since the host nginx (sites-available/lab)
# owns those and reverse-proxies /whisper-flow/ and /whisper-flow-api/ to
# these, loopback-only. See docs/ADR/010.
FRONTEND_PORT=8081
BACKEND_PORT=3010

# Must be the full page URL — used both as the post-login redirect target
# and (via its origin) as the CORS allow-origin.
FRONTEND_URL=https://lab.hitalloazevedo.com/whisper-flow/

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://lab.hitalloazevedo.com/whisper-flow-api/api/v1/auth/google/callback
SESSION_SECRET=replace-with-a-long-random-secret

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
POLL_INTERVAL_SECONDS=5
LOG_LEVEL=info
